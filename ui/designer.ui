<?xml version="1.0" encoding="UTF-8"?>
<!-- FDesigner main window. Authored for Glade / GtkBuilder, GTK 3.24. -->
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="main_window">
    <property name="title">FDesigner — C++/GTK</property>
    <property name="default_width">1150</property>
    <property name="default_height">720</property>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkMenuBar" id="menubar">
            <property name="visible">True</property>
            <child>
              <object class="GtkMenuItem" id="menu_file">
                <property name="label">File</property>
                <property name="visible">True</property>
                <child type="submenu">
                  <object class="GtkMenu" id="file_menu">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkMenuItem" id="mi_new">
                        <property name="label">New</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_open">
                        <property name="label">Open…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_save">
                        <property name="label">Save…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="mi_sep1">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_generate">
                        <property name="label">Generate C++/GTK…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="mi_sep2">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_quit">
                        <property name="label">Quit</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkPaned" id="main_paned">
            <property name="orientation">horizontal</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkScrolledWindow" id="palette_scroll">
                <property name="width_request">170</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkBox" id="palette_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <property name="margin_start">6</property>
                    <property name="margin_end">6</property>
                    <property name="margin_top">6</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkLabel" id="palette_label">
                        <property name="label">&lt;b&gt;Widgets&lt;/b&gt;</property>
                        <property name="use_markup">True</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_button">
                        <property name="label">Button</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_label">
                        <property name="label">Label</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_entry">
                        <property name="label">Entry</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_checkbutton">
                        <property name="label">CheckButton</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_radiobutton">
                        <property name="label">RadioButton</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_frame">
                        <property name="label">Frame</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_combobox">
                        <property name="label">ComboBox</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_listbox">
                        <property name="label">ListBox</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_menubutton">
                        <property name="label">MenuButton</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_canvas">
                        <property name="label">Canvas</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_scale">
                        <property name="label">Scale</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_scrollbar">
                        <property name="label">Scrollbar</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_text">
                        <property name="label">Text</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_toplevel">
                        <property name="label">Toplevel</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_spreadsheet">
                        <property name="label">Spreadsheet</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pal_stockchart">
                        <property name="label">StockChart</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="resize">False</property>
                <property name="shrink">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkPaned" id="canvas_props_paned">
                <property name="orientation">horizontal</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkScrolledWindow" id="canvas_scroll">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkFixed" id="canvas">
                        <property name="width_request">800</property>
                        <property name="height_request">600</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="resize">True</property>
                    <property name="shrink">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="props_box">
                    <property name="orientation">vertical</property>
                    <property name="width_request">280</property>
                    <property name="spacing">4</property>
                    <property name="margin_start">6</property>
                    <property name="margin_end">6</property>
                    <property name="margin_top">6</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkLabel" id="props_label">
                        <property name="label">&lt;b&gt;Properties&lt;/b&gt;</property>
                        <property name="use_markup">True</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="selected_label">
                        <property name="label">No widget selected</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="props_grid">
                        <property name="row_spacing">4</property>
                        <property name="column_spacing">6</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="resize">False</property>
                    <property name="shrink">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">True</property>
                <property name="shrink">True</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkStatusbar" id="statusbar">
            <property name="visible">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
