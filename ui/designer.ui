<?xml version="1.0" encoding="UTF-8"?>
<!-- FDesigner main window. Authored for Glade / GtkBuilder, GTK 3.24. -->
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="main_window">
    <property name="title">FDesigner — C++/GTK</property>
    <property name="default_width">1150</property>
    <property name="default_height">720</property>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkMenuBar" id="menubar">
            <property name="visible">True</property>
            <child>
              <object class="GtkMenuItem" id="menu_file">
                <property name="label">File</property>
                <property name="visible">True</property>
                <child type="submenu">
                  <object class="GtkMenu" id="file_menu">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkMenuItem" id="mi_new">
                        <property name="label">New</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_open">
                        <property name="label">Open…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_save">
                        <property name="label">Save…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="mi_sep1">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_generate">
                        <property name="label">Generate C++/GTK…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_cmake_build">
                        <property name="label">Build with CMake…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_cmake_open">
                        <property name="label">Open CMake Project…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_cmake_settings">
                        <property name="label">CMake Settings…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="mi_sep2">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_quit">
                        <property name="label">Quit</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_edit">
                <property name="label">Edit</property>
                <property name="visible">True</property>
                <child type="submenu">
                  <object class="GtkMenu" id="edit_menu">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkMenuItem" id="mi_preferences">
                        <property name="label">Preferences…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_view">
                <property name="label">View</property>
                <property name="visible">True</property>
                <child type="submenu">
                  <object class="GtkMenu" id="view_menu">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkMenuItem" id="mi_view_code">
                        <property name="label">Code View</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_view_theme">
                        <property name="label">Color Theme…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="mi_view_palette">
                        <property name="label">Widget Palette</property>
                        <property name="visible">True</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_debug">
                <property name="label">Debug</property>
                <property name="visible">True</property>
                <child type="submenu">
                  <object class="GtkMenu" id="debug_menu">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkMenuItem" id="mi_debug_open">
                        <property name="label">Open Debugger…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="mi_debug_sep1">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="menu_debugger_sub">
                        <property name="label">Debugger</property>
                        <property name="visible">True</property>
                        <child type="submenu">
                          <object class="GtkMenu" id="debugger_submenu">
                            <property name="visible">True</property>
                            <child>
                              <object class="GtkCheckMenuItem" id="mi_dbg_break_main">
                                <property name="label">Break on main</property>
                                <property name="visible">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckMenuItem" id="mi_dbg_stop_entry">
                                <property name="label">Stop on entry</property>
                                <property name="visible">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckMenuItem" id="mi_dbg_pretty">
                                <property name="label">Pretty-print values</property>
                                <property name="visible">True</property>
                                <property name="active">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparatorMenuItem" id="mi_dbg_sep">
                                <property name="visible">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuItem" id="mi_dbg_settings">
                                <property name="label">Settings…</property>
                                <property name="visible">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem" id="mi_debug_settings">
                        <property name="label">Debugger Settings…</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkPaned" id="main_paned">
            <property name="orientation">horizontal</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkPaned" id="canvas_props_paned">
                <property name="orientation">horizontal</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkScrolledWindow" id="canvas_scroll">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkFixed" id="canvas">
                        <property name="width_request">800</property>
                        <property name="height_request">600</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="resize">True</property>
                    <property name="shrink">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="props_box">
                    <property name="orientation">vertical</property>
                    <property name="width_request">280</property>
                    <property name="spacing">4</property>
                    <property name="margin_start">6</property>
                    <property name="margin_end">6</property>
                    <property name="margin_top">6</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkLabel" id="props_label">
                        <property name="label">&lt;b&gt;Properties&lt;/b&gt;</property>
                        <property name="use_markup">True</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="selected_label">
                        <property name="label">No widget selected</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="props_grid">
                        <property name="row_spacing">4</property>
                        <property name="column_spacing">6</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="resize">False</property>
                    <property name="shrink">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">True</property>
                <property name="shrink">True</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkStatusbar" id="statusbar">
            <property name="visible">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
